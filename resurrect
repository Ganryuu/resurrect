#!/usr/bin/env python3
"""Save and reopen your terminals: gnome-terminal tabs, zellij sessions (with their layout)
and the coding agents running in them (Claude Code, Codex, OpenCode), each resumed on the
conversation it had open.

Usage:
  resurrect restore [N] [--dry-run]   reopen what a snapshot holds and isn't running now
  resurrect save                      take a snapshot now
  resurrect show [N]                  the live snapshot and the history, or all of snapshot N
  resurrect autosave on|off           snapshot every minute in the background (systemd user timer)

Once the terminals have gone down (the battery dying, a reboot, logging out), their last snapshot
moves into the history, where later saves can't touch it. restore then reopens every tab of the
newest one not restored yet, or of snapshot N as numbered by show; zellij sessions that survived
(lingering keeps them running through a logout) get a tab attached again. With nothing waiting
to be restored it only reopens agent conversations and zellij sessions that were closed.
All tabs reopen in one new gnome-terminal window.
"""
import json
import os
import pwd
import re
import shlex
import sqlite3
import subprocess
import sys
import time
from collections import namedtuple
from datetime import datetime
from pathlib import Path

HOME = Path.home()
DATA = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "resurrect"
CURRENT = STATE / "current.json"
HISTORY = STATE / "history"  # <saved at>.json: the last snapshot of each time the terminals went down
KEEP = 20  # snapshots in the history
LAYOUTS = STATE / "layouts"
CLAUDE_SESSIONS = HOME / ".claude/sessions"  # <pid>.json for every running Claude Code
CLAUDE_PROJECTS = HOME / ".claude/projects"  # <project>/<session id>.jsonl transcripts
CODEX_HOME = Path(os.environ.get("CODEX_HOME") or HOME / ".codex")
CODEX_SESSIONS = CODEX_HOME / "sessions"  # YYYY/MM/DD/rollout-<time>-<thread id>.jsonl
CODEX_NAMES = CODEX_HOME / "session_index.jsonl"  # thread names
OPENCODE_DB = DATA / "opencode/opencode.db"
UNITS = HOME / ".config/systemd/user"
UNIT = "resurrect-save"
SHELL = pwd.getpwuid(os.getuid()).pw_shell or "/bin/bash"
MARK = "__resurrect__"  # placeholder line in a saved layout: "<MARK> <agent> <session id or ->"
OLD_MARK = "__resurrect_claude__"  # the same, in snapshots from before Codex and OpenCode

AGENTS = ("claude", "codex", "opencode")
WRAPPERS = {"node", "bun", "deno"}  # what an agent installed from npm runs under
BATCH = {  # subcommands that aren't the interactive TUI
    "codex": {"exec", "e", "app-server", "mcp", "mcp-server", "login", "logout", "apply", "a",
              "completion", "sandbox", "debug", "cloud", "proto", "features", "review", "help"},
    "opencode": {"run", "serve", "web", "acp", "mcp", "attach", "auth", "models", "session",
                 "export", "import", "upgrade", "uninstall", "github", "pr", "stats", "agent",
                 "debug", "generate", "completion", "help"},
}
CODEX_TERMINAL = {"codex-tui", "codex_cli_rs"}  # originators of threads started in a terminal

Proc = namedtuple("Proc", "ppid tty tpgid start argv")

PANE_COMMAND = re.compile(r'^(\s*)pane command="([^"]*)"(.*?)(\s*\{)?$')
QUOTED = re.compile(r'"((?:[^"\\]|\\.)*)"')
CWD_ATTR = re.compile(r'\bcwd="([^"]*)"')
TOP_LEVEL_TAB = re.compile(r"^    tab\b")
AFTER_TABS = re.compile(r"^    (new_tab_template|swap_tiled_layout|swap_floating_layout)\b")
PLACEHOLDER = re.compile(rf"^(\s*)(?:{MARK} (\S+)|{OLD_MARK}) (\S+)$", re.M)
UUID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
ROLLOUT = re.compile(rf"/rollout-[^/]*-({UUID.pattern})\.jsonl$")


# ---------------------------------------------------------------- reading the live state

def processes():
    """{pid: Proc} for this user's processes."""
    table = {}
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid != os.getuid():
                continue
            stat = (entry / "stat").read_text()
            argv = (entry / "cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        fields = stat[stat.rindex(")") + 2:].split()  # fields[0] is /proc stat field 3
        table[int(entry.name)] = Proc(
            ppid=int(fields[1]), tty=int(fields[4]), tpgid=int(fields[5]), start=int(fields[19]),
            argv=[a.decode(errors="replace") for a in argv if a],
        )
    return table


def started(proc):
    """When a process started, in seconds since the epoch."""
    with open("/proc/stat") as stat:
        boot = next(int(line.split()[1]) for line in stat if line.startswith("btime"))
    return boot + proc.start / os.sysconf("SC_CLK_TCK")


def proc_cwd(pid):
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return None


def proc_env(pid):
    try:
        raw = Path(f"/proc/{pid}/environ").read_bytes()
    except OSError:
        return {}
    return dict(item.split("=", 1) for item in raw.decode(errors="replace").split("\0") if "=" in item)


def open_files(pids):
    for pid in pids:
        try:
            fds = os.listdir(f"/proc/{pid}/fd")
        except OSError:
            continue
        for fd in fds:
            try:
                yield os.readlink(f"/proc/{pid}/fd/{fd}")
            except OSError:
                pass


def agent_of(argv):
    """(agent, its arguments) for a command line running one of AGENTS, else (None, [])."""
    if argv and Path(argv[0]).name in WRAPPERS:  # node /path/to/bin/codex ...
        argv = next((argv[i:] for i, arg in enumerate(argv[1:], 1) if not arg.startswith("-")), [])
    name = Path(argv[0]).name if argv else None
    return (name, argv[1:]) if name in AGENTS else (None, [])


def option(args, *names):
    """The value given to a command-line option, or None."""
    for i, arg in enumerate(args):
        for name in names:
            if arg == name and i + 1 < len(args):
                return args[i + 1]
            if name.startswith("--") and arg.startswith(name + "="):
                return arg[len(name) + 1:]
    return None


def agent_processes(procs, agent):
    """[(pid, args, cwd, start)] for the interactive `agent` TUIs running in a terminal now."""
    found = []
    for pid, proc in procs.items():
        name, args = agent_of(proc.argv)
        if name != agent or not proc.tty or BATCH[agent] & set(args):
            continue
        parent = procs.get(proc.ppid)
        if parent and agent_of(parent.argv)[0] == agent:
            continue  # the native binary under its npm wrapper: the wrapper stands for both
        found.append((pid, args, proc_cwd(pid) or str(HOME), started(proc)))
    return found


def match_sessions(found, candidates):
    """Give each running agent in `found` that doesn't know its conversation yet the newest one
    from `candidates` [(updated, session id, folder, name)], newest first, that was written in its
    folder since it started. The newest agent picks first."""
    taken = {entry["session_id"] for entry in found.values()}
    for entry in sorted(found.values(), key=lambda e: -e["start"]):
        if entry["session_id"]:
            continue
        for updated, session_id, folder, name in candidates:
            if session_id not in taken and folder == entry["cwd"] and updated >= entry["start"] - 2:
                entry.update(session_id=session_id, name=name)
                taken.add(session_id)
                break


def claude_sessions(procs):
    """{pid: conversation} for the interactive Claude Code CLIs running now."""
    found = {}
    for path in CLAUDE_SESSIONS.glob("*.json"):
        try:
            info = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        proc = procs.get(info.get("pid"))
        # Skip files left by dead processes (or a pid reused since), VS Code panels and `claude -p`.
        if not proc or str(info.get("procStart", proc.start)) != str(proc.start):
            continue
        if info.get("kind") != "interactive" or info.get("entrypoint") != "cli" or not info.get("sessionId"):
            continue
        found[info["pid"]] = {
            "agent": "claude",
            "session_id": info["sessionId"],
            "name": info.get("name") or "",
            "cwd": info.get("cwd") or proc_cwd(info["pid"]) or str(HOME),
        }
    return found


def codex_threads(since):
    """[(updated, thread id, folder, "")], newest first, for Codex threads started in a terminal
    (not subagents, `codex exec` or the VS Code extension) and written to since `since`."""
    threads = []
    for path in CODEX_SESSIONS.glob("*/*/*/rollout-*.jsonl"):
        try:
            updated = path.stat().st_mtime
            if updated < since:
                continue
            with path.open() as rollout:
                meta = json.loads(rollout.readline()).get("payload") or {}
        except (OSError, ValueError, AttributeError):
            continue
        if meta.get("originator") in CODEX_TERMINAL and isinstance(meta.get("source"), str) and meta.get("id"):
            threads.append((updated, meta["id"], os.path.realpath(meta.get("cwd") or ""), ""))
    return sorted(threads, reverse=True)


def codex_names():
    names = {}
    try:
        for line in CODEX_NAMES.read_text().splitlines():
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            if entry.get("id") and entry.get("thread_name"):
                names[entry["id"]] = entry["thread_name"]
    except OSError:
        pass
    return names


def codex_sessions(procs):
    """{pid: conversation} for the Codex TUIs running now.

    A Codex TUI that writes its own thread has the rollout file open, which names it. With the
    background app-server, the server writes every thread, so the TUI gets the newest terminal
    thread in its folder that was written since it started."""
    found = {}
    for pid, args, cwd, start in agent_processes(procs, "codex"):
        if folder := option(args, "-C", "--cd"):
            cwd = os.path.normpath(os.path.join(cwd, folder))
        session_id = next((m[1] for f in open_files([pid, *(p for p, pr in procs.items() if pr.ppid == pid)])
                           if (m := ROLLOUT.search(f))), "")
        if not session_id and "resume" in args:
            session_id = next((a for a in args[args.index("resume") + 1:] if UUID.fullmatch(a)), "")
        found[pid] = {"agent": "codex", "session_id": session_id, "name": "", "cwd": os.path.realpath(cwd), "start": start}
    if found:
        match_sessions(found, codex_threads(min(e["start"] for e in found.values()) - 5))
        names = codex_names()
        for entry in found.values():
            del entry["start"]
            entry["name"] = names.get(entry["session_id"], "")
    return found


def opencode_query(sql, params=()):
    """Rows from OpenCode's session database, or [] when it can't be read."""
    if not OPENCODE_DB.exists():
        return []
    try:
        db = sqlite3.connect(f"{OPENCODE_DB.as_uri()}?mode=ro", uri=True, timeout=2)
        try:
            return db.execute(sql, params).fetchall()
        finally:
            db.close()
    except sqlite3.Error:
        return []


def opencode_title(title):
    return "" if title.startswith("New session - ") else title  # the default, a timestamp


def opencode_sessions(procs):
    """{pid: conversation} for the OpenCode TUIs running now: the session given with --session,
    or else the newest top-level session in its folder that was updated since it started."""
    found = {}
    for pid, args, cwd, start in agent_processes(procs, "opencode"):
        project = next((a for a in args if not a.startswith("-") and os.path.isdir(os.path.join(cwd, a))), "")
        found[pid] = {"agent": "opencode", "session_id": option(args, "-s", "--session") or "", "name": "",
                      "cwd": os.path.realpath(os.path.join(cwd, project)), "start": start}
    if found:
        since = min(e["start"] for e in found.values()) - 5
        rows = opencode_query(
            "SELECT time_updated / 1000.0, id, directory, title FROM session WHERE parent_id IS NULL"
            " AND time_archived IS NULL AND time_updated >= ? ORDER BY time_updated DESC", (int(since * 1000),))
        match_sessions(found, [(t, i, os.path.realpath(d), opencode_title(n)) for t, i, d, n in rows])
        titles = dict(opencode_query(
            f"SELECT id, title FROM session WHERE id IN ({','.join('?' * len(found))})",
            [e["session_id"] for e in found.values()]))
        for entry in found.values():
            del entry["start"]
            entry["name"] = opencode_title(titles.get(entry["session_id"], ""))
    return found


def agent_sessions(procs):
    """{pid: {agent, session_id, name, cwd}} for every coding agent running in a terminal now.
    session_id is "" for an agent that hasn't started a conversation."""
    return {**claude_sessions(procs), **codex_sessions(procs), **opencode_sessions(procs)}


def zellij(*args, session=None):
    command = ["zellij", *(["--session", session] if session else []), *args]
    try:
        return subprocess.run(command, capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(command, 1, "", str(exc))


def zellij_sessions():
    """{name: alive} for every zellij session, including exited ones zellij keeps for resurrection."""
    sessions = {}
    for line in zellij("list-sessions", "--no-formatting").stdout.splitlines():
        if "[Created" in line:
            sessions[line.split()[0]] = "EXITED" not in line
    return sessions


def zellij_clients():
    """{client pid: session name}, from the unix socket each zellij client has open to its server."""
    try:
        out = subprocess.run(["ss", "-xpH"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    paths, peers = {}, {}
    for line in out.splitlines():
        cols = line.split()
        if len(cols) < 8:
            continue
        local, inode, peer = cols[4], cols[5], cols[7]
        if local != "*":
            paths[inode] = local
        for pid in re.findall(r"pid=(\d+)", line):
            peers.setdefault(int(pid), []).append(peer)
    clients = {}
    for pid, inodes in peers.items():
        for inode in inodes:
            if "/zellij/" in paths.get(inode, ""):
                clients[pid] = Path(paths[inode]).name
    return clients


def pane_agent(command, block_first_line):
    """Which agent a dumped `pane command=...` runs: the command itself, or for node and the like,
    the script named first in its args."""
    name = Path(command).name
    if name in WRAPPERS and block_first_line.lstrip().startswith("args "):
        name = next((Path(a).name for a in QUOTED.findall(block_first_line) if not a.startswith("-")), name)
    return name if name in AGENTS else None


def mark_agent_panes(layout, panes):
    """Swap each agent pane in a dumped zellij layout for a placeholder naming its conversation.

    panes: [{pid, agent, session_id, tab, cwd, x, y, floating}]. A pane is matched on its tab,
    working directory and agent; several of those are taken in screen order.
    Returns the new layout and the pids that found their pane."""
    queues = {}
    for pane in sorted(panes, key=lambda p: (p["floating"], p["y"], p["x"])):
        queues.setdefault((pane["tab"], pane["cwd"], pane["agent"]), []).append(pane)
    lines = layout.splitlines()
    out, placed = [], set()
    root, tab, tab_cwd, in_tabs, skip_to = "", -1, "", True, None
    for i, line in enumerate(lines):
        if skip_to is not None:  # the old pane's block (args, start_suspended)
            if line == skip_to:
                skip_to = None
            continue
        if AFTER_TABS.match(line):
            in_tabs = False
        if root_cwd := re.match(r'^    cwd "(.*)"$', line):
            root = root_cwd.group(1)
        if in_tabs and TOP_LEVEL_TAB.match(line):
            tab += 1
            tab_cwd = (CWD_ATTR.search(line) or [None, ""])[1]
        match = PANE_COMMAND.match(line) if in_tabs else None
        if match:
            indent, command, attrs, block = match.groups()
            agent = pane_agent(command, lines[i + 1] if block and i + 1 < len(lines) else "")
            pane_cwd = (CWD_ATTR.search(attrs) or [None, ""])[1]
            queue = agent and queues.get((tab, os.path.normpath(os.path.join(root, tab_cwd, pane_cwd)), agent))
            if queue:
                pane = queue.pop(0)
                placed.add(pane["pid"])
                skip_to = indent + "}" if block else None
                out += [f'{indent}pane command="{SHELL}"{attrs} {{',
                        f"{indent}    {MARK} {agent} {pane['session_id'] or '-'}", f"{indent}}}"]
                continue
        out.append(line)
    return "\n".join(out) + "\n", placed


def snapshot():
    procs = processes()
    agents = agent_sessions(procs)
    alive = [name for name, up in zellij_sessions().items() if up]

    # zellij sessions: the layout as zellij dumps it, with each agent pane tied to its conversation
    in_zellij = {}
    for pid in agents:
        env = proc_env(pid)
        if env.get("ZELLIJ_SESSION_NAME") in alive and env.get("ZELLIJ_PANE_ID", "").isdigit():
            in_zellij.setdefault(env["ZELLIJ_SESSION_NAME"], []).append((int(env["ZELLIJ_PANE_ID"]), pid))
    layouts, placed = {}, set()
    for name in alive:
        dumped = zellij("action", "dump-layout", session=name)
        listed = zellij("action", "list-panes", "--json", "--tab", "--geometry", "--state", session=name)
        if dumped.returncode or listed.returncode:
            print(f"warning: couldn't read zellij session {name}: {(dumped.stderr or listed.stderr).strip()}", file=sys.stderr)
            continue
        geometry = {p["id"]: p for p in json.loads(listed.stdout) if not p.get("is_plugin")}
        panes = [
            {"pid": pid, "agent": agents[pid]["agent"], "session_id": agents[pid]["session_id"],
             "tab": g["tab_position"], "cwd": proc_cwd(pid), "x": g["pane_x"], "y": g["pane_y"],
             "floating": g["is_floating"]}
            for pane_id, pid in in_zellij.get(name, []) if (g := geometry.get(pane_id))
        ]
        layout, found = mark_agent_panes(dumped.stdout, panes)
        layouts[name] = {"layout": layout, "agents": [agents[pid] for pid in found]}
        placed |= found

    # gnome-terminal tabs, oldest first: each one's shell is a direct child of gnome-terminal-server
    servers = {pid for pid, p in procs.items() if p.argv and p.argv[0].endswith("gnome-terminal-server")}
    shells = sorted((pid for pid, p in procs.items() if p.ppid in servers), key=lambda pid: procs[pid].start)
    agent_in_tab = {}
    for pid in sorted(set(agents) - placed, key=lambda pid: procs[pid].start):
        ancestor = procs[pid].ppid
        while ancestor > 1 and ancestor not in shells:
            ancestor = procs[ancestor].ppid if ancestor in procs else 1
        if ancestor in shells:
            agent_in_tab.setdefault(ancestor, pid)

    tabs, clients = [], None
    for shell in shells:
        foreground = procs.get(procs[shell].tpgid)
        if shell in agent_in_tab:
            pid = agent_in_tab[shell]
            tabs.append(agent_tab(agents[pid]))
            placed.add(pid)
        elif foreground and foreground.argv and Path(foreground.argv[0]).name == "zellij":
            clients = zellij_clients() if clients is None else clients
            name = clients.get(procs[shell].tpgid)
            if name in layouts and not any(t.get("session") == name for t in tabs):
                tabs.append({"kind": "zellij", "session": name})
        else:
            tabs.append({"kind": "shell", "cwd": proc_cwd(shell) or str(HOME)})
    # Detached zellij sessions and agents running anywhere else (VS Code terminal, ...) go last.
    tabs += [{"kind": "zellij", "session": n} for n in layouts if not any(t.get("session") == n for t in tabs)]
    tabs += [agent_tab(agents[pid]) for pid in agents if pid not in placed]

    return {
        "version": 2,
        "saved_at": datetime.now().isoformat(timespec="seconds"),
        "boot_id": boot_id(),
        "terminal": ",".join(f"{pid}:{procs[pid].start}" for pid in sorted(servers)) or None,
        "tabs": tabs,
        "zellij": layouts,
    }


def agent_tab(entry):
    """A snapshot tab for an agent: its kind is the agent's name."""
    return {"kind": entry["agent"], **{k: v for k, v in entry.items() if k != "agent"}}


def zellij_agents(saved):
    """The agents a saved zellij session holds, also from snapshots that only knew Claude."""
    return saved.get("agents") or [{"agent": "claude", **c} for c in saved.get("claude", [])]


# ---------------------------------------------------------------- snapshots on disk

def boot_id():
    return Path("/proc/sys/kernel/random/boot_id").read_text().strip()


def read_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def write_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=1))
    os.replace(tmp, path)


def process_alive(pid_start):
    pid, start = pid_start.split(":")
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return False
    return stat[stat.rindex(")") + 2:].split()[19] == start


def set_aside(snap, pending=True):
    """Add a snapshot to the history; `pending` until a restore, which then picks it by default."""
    write_json(HISTORY / f"{snap['saved_at']}.json", {**snap, "pending": pending})
    for old in sorted(HISTORY.glob("*.json"))[:-KEEP]:
        old.unlink()


def history():
    """[(path, snapshot)] of the history, newest first."""
    found = [(path, read_json(path)) for path in sorted(HISTORY.glob("*.json"), reverse=True)]
    return [(path, snap) for path, snap in found if snap]


def rotate():
    """Once the terminals of the live snapshot are gone (reboot, logout, crash), move it into
    the history, so new saves can't overwrite it."""
    for name, pending in (("previous.json", True), ("previous.restored.json", False)):
        if old := read_json(STATE / name):  # from before there was a history
            set_aside(old, pending)
        (STATE / name).unlink(missing_ok=True)
    snap = read_json(CURRENT)
    if not snap:
        return
    servers = (snap.get("terminal") or "").split(",")
    if snap.get("boot_id") == boot_id() and all(process_alive(s) for s in servers if s):
        return
    # Nothing but shells in the home folder is a terminal opened and closed again: not worth
    # a place in the history, and it mustn't become what restore picks.
    if not all(tab["kind"] == "shell" and tab["cwd"] == str(HOME) for tab in snap["tabs"]):
        set_aside(snap)
    CURRENT.unlink()


# ---------------------------------------------------------------- reopening

def resume_command(agent, session_id):
    """Shell command that brings an agent back on its conversation, then leaves a shell behind
    like before. A conversation that has since been deleted gets a fresh start."""
    quoted = shlex.quote(session_id)
    if agent == "claude" and session_id and any(CLAUDE_PROJECTS.glob(f"*/{session_id}.jsonl")):
        command = f"claude --resume {quoted}"
    elif agent == "codex" and session_id and any(CODEX_SESSIONS.glob(f"*/*/*/rollout-*-{session_id}.jsonl")):
        command = f"codex resume {quoted}"
    elif agent == "opencode" and session_id and opencode_query("SELECT 1 FROM session WHERE id = ?", (session_id,)):
        command = f"opencode --session {quoted}"
    else:
        command = agent
    return f"{command}; exec {shlex.quote(SHELL)}"


def render_layout(layout, skip):
    """Fill the placeholders of a saved layout; conversations in `skip` are already open elsewhere."""
    def fill(match):
        indent, agent, session_id = match.groups()
        agent, session_id = agent or "claude", "" if session_id == "-" else session_id
        if session_id and (agent, session_id) in skip:
            return ""  # just a shell in that pane
        skip.add((agent, session_id))
        return f'{indent}args "-ic" {json.dumps(resume_command(agent, session_id))}'
    return PLACEHOLDER.sub(fill, layout)


def label(entry):
    return f"{entry['agent']:<10}{entry.get('name') or entry.get('session_id') or '(new)'}"


def plan_restore(snap, terminals_gone):
    """[(label, cwd, shell command or None)] for every tab to open, plus zellij layouts to write."""
    procs = processes()
    opened = {(a["agent"], a["session_id"]) for a in agent_sessions(procs).values() if a["session_id"]}
    sessions = zellij_sessions()
    tabs, layouts = [], {}
    for tab in snap["tabs"]:
        kind = tab["kind"]
        if kind == "shell" and terminals_gone:
            tabs.append(("shell", tab["cwd"], None))
        elif kind in AGENTS:
            entry = {"agent": kind, **tab}
            key = (kind, tab.get("session_id") or "")
            # One with no conversation can't be told apart from a running one; reopen it only
            # once everything went down.
            if (key[1] or terminals_gone) and key not in opened:
                if key[1]:
                    opened.add(key)
                tabs.append((label(entry), tab["cwd"], resume_command(*key)))
        elif kind == "zellij" and sessions.get(tab["session"]):
            # Still running (it outlived the terminals): attach a tab again unless one is attached.
            clients = zellij("action", "list-clients", session=tab["session"]).stdout.splitlines()[1:]
            if terminals_gone and not any(line.strip() for line in clients):
                command = f"zellij attach {shlex.quote(tab['session'])}; exec {shlex.quote(SHELL)}"
                tabs.append((f"{'zellij':<10}{tab['session']}  (attach)", str(HOME), command))
        elif kind == "zellij":
            name, saved = tab["session"], snap["zellij"][tab["session"]]
            layouts[name] = render_layout(saved["layout"], opened)
            names = ", ".join(a["agent"] + " " + (a["name"] or a["session_id"][:8] or "(new)") for a in zellij_agents(saved))
            command = f"zellij --session {shlex.quote(name)} --new-session-with-layout {shlex.quote(str(LAYOUTS / f'{name}.kdl'))}; exec {shlex.quote(SHELL)}"
            tabs.append((f"{'zellij':<10}{name}" + (f"  ({names})" if names else ""), str(HOME), command))
    return tabs, layouts, sessions


def open_tabs(tabs):
    for i, (_label, cwd, command) in enumerate(tabs):
        argv = ["gnome-terminal", "--window" if i == 0 else "--tab",
                f"--working-directory={cwd if os.path.isdir(cwd) else HOME}"]
        if command:
            argv += ["--", SHELL, "-ic", command]
        subprocess.run(argv, check=False)
        time.sleep(0.6 if i == 0 else 0.2)  # later --tab calls land in the last-opened window


# ---------------------------------------------------------------- commands

def describe(tab, snap):
    where = lambda path: path.replace(str(HOME), "~", 1)
    if tab["kind"] == "shell":
        return f"{'shell':<10}{where(tab['cwd'])}"
    if tab["kind"] in AGENTS:
        return f"{label({'agent': tab['kind'], **tab})}  {where(tab['cwd'])}"
    names = ", ".join(f"{a['agent']}: {a['name'] or a['session_id'][:8] or '(new)'}" for a in zellij_agents(snap["zellij"][tab["session"]]))
    return f"{'zellij':<10}{tab['session']}" + (f"  ({names})" if names else "")


def cmd_save(auto=False):
    rotate()
    snap = snapshot()
    if auto and not snap["tabs"]:
        return  # nothing open (logging out, shutting down): keep the last real snapshot
    write_json(CURRENT, snap)
    if not auto:
        print(f"Saved {len(snap['tabs'])} tabs to {CURRENT}")
        for tab in snap["tabs"]:
            print(f"  {describe(tab, snap)}")


def when(snap):
    return snap["saved_at"].replace("T", " ")[:16]


def cmd_show(pick=None):
    rotate()
    past = history()
    if pick is not None:
        snap = chosen(past, pick)[1]
        print(f"Snapshot {pick}, {when(snap)}")
        for tab in snap["tabs"]:
            print(f"  {describe(tab, snap)}")
        return
    live = read_json(CURRENT)
    if live:
        print(f"Live snapshot {when(live)}")
        for tab in live["tabs"]:
            print(f"  {describe(tab, live)}")
        print()
    if past:
        print("History, from before the terminals went down ('resurrect show N', 'resurrect restore N'):")
        for n, (_path, snap) in enumerate(past, 1):
            print(history_line(n, snap))
        print()
    if not live and not past:
        print("No snapshot yet: run 'resurrect save'.\n")
    on = subprocess.run(["systemctl", "--user", "is-active", "--quiet", f"{UNIT}.timer"]).returncode == 0
    print(f"Autosave: {'on, every minute' if on else 'off'}")


def history_line(n, snap):
    agents = sum(t["kind"] in AGENTS for t in snap["tabs"]) + sum(len(zellij_agents(z)) for z in snap["zellij"].values())
    plural = lambda count, word: f"{count:>2} {word}{'' if count == 1 else 's'}"
    return (f"  {n:>2}  {when(snap)}  {plural(len(snap['tabs']), 'tab')}, {plural(agents, 'agent').strip()}"
            + ("  (not restored yet)" if snap.get("pending") else ""))


def chosen(past, pick):
    if not 1 <= pick <= len(past):
        sys.exit(f"No snapshot {pick} in the history: see 'resurrect show'.")
    return past[pick - 1]


def cmd_restore(pick=None, dry_run=False):
    rotate()
    past = history()
    pending = [entry for entry in past if entry[1].get("pending")]
    if pick is not None:
        snap = chosen(past, pick)[1]
    elif len(pending) > 1:  # the newest may be a few tabs opened in between: don't guess
        print("More than one snapshot hasn't been restored. Pick one with 'resurrect restore N':")
        for n, (_path, snap) in enumerate(past, 1):
            if snap.get("pending"):
                print(history_line(n, snap).replace("  (not restored yet)", ""))
        return
    elif pending:
        snap = pending[0][1]
    else:
        snap = read_json(CURRENT)
        if not snap:
            print("No snapshot to restore. Run 'resurrect save' or 'resurrect autosave on' first.")
            return
    terminals_gone = pick is not None or bool(pending)
    tabs, layouts, sessions = plan_restore(snap, terminals_gone)
    if tabs:
        print(f"{'Would reopen' if dry_run else 'Reopening'} {len(tabs)} tabs from the {when(snap)} snapshot:")
        for name, cwd, _ in tabs:
            print(f"  {name}" if name.startswith("zellij") else f"  {name}  {cwd.replace(str(HOME), '~', 1)}")
    else:
        print(f"Everything from the {when(snap)} snapshot is already open.")
    if dry_run:
        return
    if tabs:
        LAYOUTS.mkdir(parents=True, exist_ok=True)
        for name, layout in layouts.items():
            if name in sessions:  # an exited copy zellij kept; the saved layout replaces it
                zellij("delete-session", name)
            (LAYOUTS / f"{name}.kdl").write_text(layout)
        open_tabs(tabs)
    if terminals_gone:  # settled: the next restore is about what's live again
        for path, other in pending:
            write_json(path, {k: v for k, v in other.items() if k != "pending"})


SERVICE = f"""[Unit]
Description=Snapshot terminals and coding-agent sessions for resurrect

[Service]
Type=oneshot
ExecStart={Path(__file__).resolve()} save --auto
"""

TIMER = """[Unit]
Description=Snapshot terminals and coding-agent sessions every minute

[Timer]
OnStartupSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
"""


def cmd_autosave(state):
    systemctl = lambda *args: subprocess.run(["systemctl", "--user", *args], check=False)
    if state == "on":
        UNITS.mkdir(parents=True, exist_ok=True)
        (UNITS / f"{UNIT}.service").write_text(SERVICE)
        (UNITS / f"{UNIT}.timer").write_text(TIMER)
        systemctl("daemon-reload")
        systemctl("enable", "--now", f"{UNIT}.timer")
        cmd_save()
        print("Autosave on: a snapshot every minute.")
    elif state == "off":
        systemctl("disable", "--now", f"{UNIT}.timer")
        print("Autosave off. The last snapshot is kept.")
    else:
        sys.exit("usage: resurrect autosave on|off")


if __name__ == "__main__":
    args = sys.argv[1:]
    command = args[0] if args else "show"
    pick = next((int(arg) for arg in args[1:] if arg.isdigit()), None)
    if command == "save":
        cmd_save(auto="--auto" in args)
    elif command == "restore":
        cmd_restore(pick, dry_run="--dry-run" in args or "-n" in args)
    elif command == "show":
        cmd_show(pick)
    elif command == "autosave":
        cmd_autosave(args[1] if len(args) > 1 else "")
    else:
        print(__doc__.strip())
        sys.exit(0 if command in ("-h", "--help", "help") else 1)
